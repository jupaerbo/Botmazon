# ============================================================
#  Amazon Bargain Bot - plantilla de variables de entorno
#  Local: copia este archivo como ".env" y rellénalo.
#  Render: define estas variables en Dashboard > Environment.
#  Las variables del sistema tienen prioridad sobre el .env.
# ============================================================

# --- Obligatorias ---
# Token de @BotFather
TELEGRAM_TOKEN=
# Tu chat ID (python main.py --get-chat-id). Varios separados por comas.
CHAT_ID=

# --- Opcionales ---
# Alertas push directas: errors (solo errores de precio) | all | none
PUSH_MODE=errors
# Umbral de la sección "Ver Todo"
TOP_PERCENT=40
# Proxy para el scraping si Amazon bloquea la IP del servidor (http://usuario:clave@host:puerto)
PROXY_URL=
# Tag de afiliado de Amazon (se añade a los enlaces)
AMAZON_AFFILIATE_TAG=
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# false en servidores con disco efímero (Render)
LOG_TO_FILE=true
# Self-ping a RENDER_EXTERNAL_URL cada ~10 min (plan Free de Render)
SELF_PING=true
# true = no envía alertas push (el menú sí funciona)
DRY_RUN=false

# --- Sobrescriben valores de config.json ---
# MIN_DROP_TECH=30
# MIN_DROP_GAMING=30
# MIN_DROP_MTG=25
# PRICE_ERROR_PERCENT=60
# DEDUP_HOURS=36

# --- Rutas (normalmente no hace falta tocarlas) ---
# CONFIG_PATH=config.json
# HISTORY_PATH=data/history.json
# ACTIVE_DEALS_PATH=data/active_deals.json
